+  it('generates a parseable PaiNuo provider patch with a brand default model', () => {
+    const patch = paiNuoProviderPatch([
+      { id: BRAND_DEFAULT_MODEL_ID, name: BRAND_DEFAULT_MODEL_ID },
+      { id: 'deepseek-v4-pro', name: 'DeepSeek-V4-Pro' },
+    ])
+    expect(patch).toContain(`baseURL: ${BRAND_INFERENCE_BASE_URL}`)
+    expect(patch).toContain(`provider: ${BRAND_PROVIDER_ID}`)
+    expect(patch).toContain(`model: "${BRAND_DEFAULT_MODEL_ID}"`)
+    expect(patch).not.toMatch(/deepseek\.com|deepseeksvc\.com/u)
+    // The Models page and the model selector render this catalog name; every
+    // wire id stays the provider's own, so a request still names the same model.
+    expect(patch).toContain(`displayName: ${BRAND_PROVIDER_DISPLAY_NAME}`)
+    const parsed = yaml.load(patch, { schema: entryListSchema })
+    expect(parsed).toEqual([
+      expect.objectContaining({
+        id: 'llm-pi-ai',
+        config: {
+          providers: {
+            [BRAND_PROVIDER_ID]: expect.objectContaining({
+              displayName: BRAND_PROVIDER_DISPLAY_NAME,
+              models: [
+                { id: BRAND_DEFAULT_MODEL_ID, name: '派诺·DeepSeek-V4.1-Flash-1017-Local' },
+                { id: 'deepseek-v4-pro', name: '派诺·DeepSeek-V4-Pro' },
+              ],
+            }),
+          },
+        },
+      }),
+      expect.objectContaining({ id: 'agent-default-model', config: { provider: BRAND_PROVIDER_ID, model: BRAND_DEFAULT_MODEL_ID } }),
+    ])
+  })
+
+  it('produces no provider patch from an empty catalog, keeping the route fail-closed', () => {
+    expect(paiNuoProviderPatch([])).toBe('')
+    expect(chooseDefaultModel([])).toBeUndefined()
+    expect(chooseDefaultModel([{ id: 'other', name: 'other' }])).toBe('other')
+    expect(chooseDefaultModel([{ id: 'other', name: 'other' }, { id: BRAND_DEFAULT_MODEL_ID, name: 'flash' }]))
+      .toBe(BRAND_DEFAULT_MODEL_ID)
+  })
+})
diff --git a/apps/desktop/tests/brand-packaging.spec.ts b/apps/desktop/tests/brand-packaging.spec.ts
new file mode 100644
index 0000000000..9e8ccf2a48
--- /dev/null
+++ b/apps/desktop/tests/brand-packaging.spec.ts
@@ -0,0 +1,121 @@
+import { mkdtempSync, readFileSync, rmSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { afterEach, describe, expect, it } from 'vitest'
+import { initProfile } from '@deepseek-ai/dsh-app-boot'
+import {
+  applyBrandDefaults,
+  BRAND_DEFAULTS_BEGIN,
+  BRAND_DEFAULTS_END,
+  brandDefaultsBlock,
+  brandWorkspaceBlock,
+  composeBrandDefaults,
+} from '../src/brand-defaults.ts'
+
+const tempDirs: string[] = []
+
+afterEach(() => {
+  for (const dir of tempDirs.splice(0)) rmSync(dir, { recursive: true, force: true })
+})
+
+const UNSIGNED_MAC = {
+  DSH_DESKTOP_APP_ID: 'cc.example.app',
+  DSH_DESKTOP_UNSIGNED: '1',
+  DSH_DESKTOP_TARGET_PLATFORM: 'darwin',
+  DSH_DESKTOP_TARGET_ARCH: 'arm64',
+}
+
+describe('branded packaging identity', () => {
+  it('keeps upstream protocol metadata when no brand environment is supplied', async () => {
+    const { createElectronBuilderConfig } = await import('../scripts/electron-builder-config.mjs')
+    const config = createElectronBuilderConfig(UNSIGNED_MAC, 'darwin', 'arm64')
+    expect(config.protocols).toEqual([{ name: 'DeepSeek Harness', schemes: ['dsh'] }])
+    expect(config.extraMetadata).toMatchObject({ dshDesktopProtocolScheme: 'dsh' })
+    expect(config.extraMetadata).not.toHaveProperty('productName')
+    expect(config.extraMetadata).not.toHaveProperty('dshDesktopProfileDirectory')
+  })
+
+  it('writes the declared scheme into the manifest used by runtime registration', async () => {
+    const { createElectronBuilderConfig } = await import('../scripts/electron-builder-config.mjs')
+    const config = createElectronBuilderConfig({
+      ...UNSIGNED_MAC,
+      DSH_DESKTOP_PRODUCT_NAME: '随身搭子',
+      DSH_DESKTOP_PROTOCOL_SCHEME: 'suishendazi',
+      DSH_DESKTOP_ARTIFACT_PREFIX: 'suishendazi-harness',
+    }, 'darwin', 'arm64')
+    expect(config.protocols).toEqual([{ name: '随身搭子', schemes: ['suishendazi'] }])
+    expect(config.extraMetadata).toMatchObject({
+      dshDesktopProtocolScheme: 'suishendazi',
+      productName: '随身搭子',
+      dshDesktopProfileDirectory: 'cc.example.app',
+    })
+  })
+})
+
+describe('branded profile defaults', () => {
+  it('routes the default model to the branded provider instead of the public DeepSeek API', () => {
+    const block = brandDefaultsBlock()
+    expect(block).toContain('provider: painuo')
+    expect(block).toContain('model: deepseek-v4.1-flash-1017-local')
+    expect(block).not.toContain('deepseek-official')
+  })
+
+  it('does not pin upstream web search or ship upstream telemetry endpoints', () => {
+    const block = brandDefaultsBlock()
+    expect(block).not.toContain('searchProvider: deepseek-official')
+    expect(block).not.toContain('suishendazi-harness-desktop')
+    expect(block).not.toContain('dsh-otel-collector.deepseeksvc.com')
+    expect(block).toContain('- id: desktop-product-telemetry\n  disabled: true')
+    expect(block).toContain('- id: product-analytics\n  disabled: true')
+  })
+
+  it('replaces the empty upstream patch and stays idempotent', () => {
+    const first = composeBrandDefaults('[]\n')
+    expect(first.startsWith(BRAND_DEFAULTS_BEGIN)).toBe(true)
+    expect(first).not.toContain('[]')
+    expect(first.match(/brand-defaults: begin/gu)).toHaveLength(1)
+    expect(first.match(/brand-defaults: end/gu)).toHaveLength(1)
+    expect(composeBrandDefaults(first)).toBe(first)
+  })
+
+  it('preserves user rows after the generated block', () => {
+    const userRow = '- id: agent-default-model\n  config:\n    provider: custom\n    model: chosen\n'
+    const next = composeBrandDefaults(`${brandDefaultsBlock()}${userRow}`)
+    expect(next.match(/brand-defaults: begin/gu)).toHaveLength(1)
+    expect(next).toContain(userRow)
+    expect(next.indexOf(BRAND_DEFAULTS_BEGIN)).toBeLessThan(next.indexOf('- id: agent-default-model'))
+    expect(next.lastIndexOf('- id: agent-default-model')).toBeGreaterThan(next.indexOf(BRAND_DEFAULTS_END))
+  })
+
+  it('leaves an unterminated hand-edited block alone instead of swallowing later rows', () => {
+    const existing = `${BRAND_DEFAULTS_BEGIN} - hand edited\n- id: user-row\n`
+    expect(composeBrandDefaults(existing)).toBe(existing)
+  })
+
+  it('keeps the branded first-use Workspace row in the same generated patch', () => {
+    const workspace = brandWorkspaceBlock('/Users/a/Documents/随身搭子/default-workspace')
+    expect(workspace).toContain('- id: workspace-controller')
+    expect(workspace).toContain('defaultWorkspacePath: "/Users/a/Documents/随身搭子/default-workspace"')
+    expect(workspace).not.toContain('defaultWorkspacePath: "/Users/a/Documents/deepseek-harness/default-workspace"')
+  })
+
+  it('writes the generated patch into a freshly initialized desktop profile', () => {
+    const home = mkdtempSync(join(tmpdir(), 'sdz-brand-profile-'))
+    tempDirs.push(home)
+    const profile = join(home, 'profiles', 'desktop')
+    initProfile(profile, ['@deepseek-ai/dsh-base', '@deepseek-ai/dsh-web-app'])
+    const patch = join(profile, 'cordis.patch.yml')
+    expect(applyBrandDefaults(patch)).toBe(true)
+    const content = readFileSync(patch, 'utf8')
+    expect(content).toContain('provider: painuo')
+    expect(content).not.toContain('deepseek-official')
+    expect(applyBrandDefaults(patch)).toBe(false)
+    expect(readFileSync(patch, 'utf8')).toBe(content)
+    const manifest = JSON.parse(readFileSync(join(profile, 'package.json'), 'utf8')) as {
+      name?: string
+      dsh?: { profile?: { bundles?: string[] } }
+    }
+    expect(manifest.name).toBe('dsh-profile-desktop')
+    expect(manifest.dsh?.profile?.bundles).toEqual(['@deepseek-ai/dsh-base', '@deepseek-ai/dsh-web-app'])
+  })
+})
diff --git a/apps/desktop/tests/cloud-screen-preload.spec.ts b/apps/desktop/tests/cloud-screen-preload.spec.ts
new file mode 100644
index 0000000000..50c4033e4b
--- /dev/null
+++ b/apps/desktop/tests/cloud-screen-preload.spec.ts
@@ -0,0 +1,54 @@
+// @vitest-environment jsdom
+//
+// Cross-client live cloud desktop (HUI-4001): the renderer-facing bridge offers
+// exactly two operations and passes the screen id / URL through unchanged. The
+// main process owns credential classification, the delegate request, and the
+// gateway-origin restriction; this spec pins the preload half of that split.
+import { beforeEach, expect, it, vi } from 'vitest'
+import { DESKTOP_IPC, type DshDesktopProductApi } from '../src/ipc.ts'
+
+const electron = vi.hoisted(() => ({
+  contextBridge: { exposeInMainWorld: vi.fn() },
+  ipcRenderer: { invoke: vi.fn(), on: vi.fn(), off: vi.fn(), send: vi.fn() },
+  webUtils: { getPathForFile: vi.fn() },
+}))
+vi.mock('electron', () => electron)
+vi.mock('../src/preload-platform.ts', () => ({ markDocumentPlatform: vi.fn(), syncWindowFullscreen: vi.fn() }))
+vi.mock('../src/preload-theme.ts', () => ({ syncNativeTheme: vi.fn() }))
+vi.mock('../src/preload-windows.ts', () => ({ syncWindowsAppearance: vi.fn() }))
+vi.mock('../src/preload-mandatory-overlay.ts', () => ({ installMandatoryUpdateOverlay: vi.fn() }))
+
+beforeEach(() => {
+  vi.clearAllMocks()
+  vi.resetModules()
+  vi.stubGlobal('process', { ...process, isMainFrame: true })
+  vi.stubGlobal('location', new URL('dsh-app://app/index.html'))
+})
+
+const productApi = async (): Promise<DshDesktopProductApi> => {
+  await import('../src/preload-app.ts')
+  return electron.contextBridge.exposeInMainWorld.mock.calls.find(([name]) => name === 'dshDesktop')?.[1] as DshDesktopProductApi
+}
+
+it('routes a screen-id request to the main-process delegate handler', async () => {
+  electron.ipcRenderer.invoke.mockResolvedValueOnce({ kind: 'sidebar-guest', url: 'https://agentbuddy.modelxing.com/api/npw/screen/scrn_1/delegate/open?d=t' })
+  const api = await productApi()
+  const plan = await api.cloudScreen.request('scrn_1')
+  expect(electron.ipcRenderer.invoke).toHaveBeenCalledExactlyOnceWith(DESKTOP_IPC.cloudScreenRequest, 'scrn_1')
+  expect(plan).toEqual({ kind: 'sidebar-guest', url: 'https://agentbuddy.modelxing.com/api/npw/screen/scrn_1/delegate/open?d=t' })
+})
+
+it('routes an explicit system-browser open to the main-process URL check', async () => {
+  electron.ipcRenderer.invoke.mockResolvedValueOnce(true)
+  const api = await productApi()
+  await expect(api.cloudScreen.openExternal('https://agentbuddy.modelxing.com/console.html')).resolves.toBe(true)
+  expect(electron.ipcRenderer.invoke).toHaveBeenCalledExactlyOnceWith(DESKTOP_IPC.cloudScreenOpenExternal, 'https://agentbuddy.modelxing.com/console.html')
+})
+
+it('does not expose a shell opener, a credential, or a raw fetch to product documents', async () => {
+  const api = await productApi()
+  expect(api.cloudScreen).not.toHaveProperty('credential')
+  expect(api.cloudScreen).not.toHaveProperty('shell')
+  expect(api.cloudScreen).not.toHaveProperty('fetch')
+  expect(api).not.toHaveProperty('ipcRenderer')
+})
diff --git a/apps/desktop/tests/cloud-screen.spec.ts b/apps/desktop/tests/cloud-screen.spec.ts
new file mode 100644
index 0000000000..492d441424
--- /dev/null
+++ b/apps/desktop/tests/cloud-screen.spec.ts
@@ -0,0 +1,172 @@
+import { describe, expect, it, vi } from 'vitest'
+import {
+  classifyGatewayCredential,
+  cloudScreenConsoleUrl,
+  cloudScreenDelegateUrlAllowed,
+  cloudScreenExternalUrlAllowed,
+  planCloudScreen,
+  requestCloudScreenDelegate,
+  resolveCloudScreenCredential,
+} from '../src/cloud-screen.ts'
+import { BRAND_CLOUD_DESKTOP_API_ORIGIN } from '../src/brand-endpoints.ts'
+
+const origin = BRAND_CLOUD_DESKTOP_API_ORIGIN
+const scrn = 'scrn_01HZZZZZZZZZZZZZZZZZZZZZQA'
+const ticket = 'djF8eyJrIjoiZGVsZWdhdGUifQ'
+const grantedUrl = `${origin}/api/npw/screen/${scrn}/delegate/open?d=${ticket}&c=desktop`
+
+const jsonResponse = (status: number, body: unknown): Response =>
+  new Response(JSON.stringify(body), { status, headers: { 'content-type': 'application/json' } })
+
+describe('gateway credential classification', () => {
+  it('routes the two wire forms the gateway accepts', () => {
+    expect(classifyGatewayCredential('sdzs_0123456789abcdef')).toBe('account_session')
+    expect(classifyGatewayCredential('eyJhbGciOiJFZERTQSJ9.eyJzdWIiOiJ1c3JfMSJ9.c2ln')).toBe('platform_jwt')
+  })
+
+  it('refuses the shim grant and anything malformed instead of sending it', () => {
+    // The model-proxy grant is opaque and audience-bound: an agentbuddy gateway
+    // answers 401, so it must never be sent as a platform credential.
+    expect(classifyGatewayCredential('sdzdsh_abcdef')).toBe('unsupported')
+    expect(classifyGatewayCredential('')).toBe('unsupported')
+    expect(classifyGatewayCredential('   ')).toBe('unsupported')
+    expect(classifyGatewayCredential('not-a-token')).toBe('unsupported')
+    expect(classifyGatewayCredential('two.segments')).toBe('unsupported')
+  })
+
+  it('prefers the deployment credential seam over the stored shim grant', () => {
+    const jwt = 'eyJhbGciOiJFZERTQSJ9.eyJzdWIiOiJ1c3JfMSJ9.c2ln'
+    expect(resolveCloudScreenCredential({ DSH_CLOUD_SCREEN_TOKEN: jwt }, () => 'sdzdsh_shim')).toEqual({
+      credential: jwt, kind: 'platform_jwt',
+    })
+    expect(resolveCloudScreenCredential({}, () => 'sdzdsh_shim')).toEqual({
+      credential: 'sdzdsh_shim', kind: 'unsupported',
+    })
+    expect(resolveCloudScreenCredential({}, () => undefined)).toEqual({ credential: '', kind: 'unsupported' })
+  })
+})
+
+describe('delegate URL restriction', () => {
+  it('accepts only the gateway origin path for the requested screen with a ticket', () => {
+    expect(cloudScreenDelegateUrlAllowed(grantedUrl, origin, scrn)).toBe(true)
+    expect(cloudScreenDelegateUrlAllowed(`https://evil.example.com/api/npw/screen/${scrn}/delegate/open?d=${ticket}`, origin, scrn)).toBe(false)
+    expect(cloudScreenDelegateUrlAllowed(`${origin}/api/npw/screen/scrn_01HZZZZZZZZZZZZZZZZZZZZZQB/delegate/open?d=${ticket}`, origin, scrn)).toBe(false)
+    expect(cloudScreenDelegateUrlAllowed(`${origin}/api/npw/screen/${scrn}/novnc/vnc.html?d=${ticket}`, origin, scrn)).toBe(false)
+    expect(cloudScreenDelegateUrlAllowed(`${origin}/api/npw/screen/${scrn}/delegate/open?c=desktop`, origin, scrn)).toBe(false)
+    expect(cloudScreenDelegateUrlAllowed(`https://u:p@agentbuddy.modelxing.com/api/npw/screen/${scrn}/delegate/open?d=${ticket}`, origin, scrn)).toBe(false)
+    expect(cloudScreenDelegateUrlAllowed(grantedUrl, 'not an origin', scrn)).toBe(false)
+  })
+})
+
+describe('delegate request', () => {
+  it('posts to the gateway delegate path with the credential and channel=desktop', async () => {
+    const fetchImpl = vi.fn(async () => jsonResponse(200, { url: grantedUrl, screenId: scrn, mode: 'viewer', expiresAt: 1_792_100_060 }))
+    const result = await requestCloudScreenDelegate({
+      screenId: scrn, credential: 'sdzs_session', fetchImpl: fetchImpl as unknown as typeof fetch,
+    })
+    expect(result).toEqual({ kind: 'granted', url: grantedUrl, expiresAt: 1_792_100_060, mode: 'viewer' })
+    const [url, init] = fetchImpl.mock.calls[0] as unknown as [string, RequestInit]
+    expect(url).toBe(`${origin}/api/npw/screen/${scrn}/delegate?channel=desktop`)
+    expect(init.method).toBe('POST')
+    expect((init.headers as Record<string, string>).authorization).toBe('Bearer sdzs_session')
+  })
+
+  it('never sends an unsupported credential', async () => {
+    const fetchImpl = vi.fn()
+    const result = await requestCloudScreenDelegate({
+      screenId: scrn, credential: 'sdzdsh_shim', fetchImpl: fetchImpl as unknown as typeof fetch,
+    })
+    expect(result).toEqual({ kind: 'unavailable', reason: 'credential_unsupported_for_gateway' })
+    expect(fetchImpl).not.toHaveBeenCalled()
+  })
+
+  it('requires a screen id and a credential', async () => {
+    expect(await requestCloudScreenDelegate({ screenId: '  ', credential: 'sdzs_x' })).toEqual({
+      kind: 'unavailable', reason: 'screen_id_required',
+    })
+    expect(await requestCloudScreenDelegate({ screenId: scrn, credential: '' })).toEqual({
+      kind: 'unavailable', reason: 'credential_missing',
+    })
+  })
+
+  it('maps gateway refusals to their contract code and 503 to a capability gap', async () => {
+    const refused = await requestCloudScreenDelegate({
+      screenId: scrn, credential: 'sdzs_x',
+      fetchImpl: (async () => jsonResponse(403, { error: 'lease_not_holder' })) as unknown as typeof fetch,
+    })
+    expect(refused).toEqual({ kind: 'refused', status: 403, code: 'lease_not_holder' })
+    const absent = await requestCloudScreenDelegate({
+      screenId: scrn, credential: 'sdzs_x',
+      fetchImpl: (async () => jsonResponse(503, { code: 'provider_unavailable' })) as unknown as typeof fetch,
+    })
+    expect(absent).toEqual({ kind: 'unavailable', reason: 'capability_absent' })
+  })
+
+  it('rejects a fabricated payload instead of opening it', async () => {
+    for (const body of [
+      null,
+      {},
+      { url: grantedUrl, screenId: scrn, expiresAt: 0, mode: 'viewer' },
+      { url: grantedUrl, screenId: 'scrn_01HZZZZZZZZZZZZZZZZZZZZZQB', expiresAt: 1, mode: 'viewer' },
+      { url: `https://evil.example.com/api/npw/screen/${scrn}/delegate/open?d=${ticket}`, screenId: scrn, expiresAt: 1, mode: 'viewer' },
+      { url: `${origin}/api/npw/screen/${scrn}/delegate/open?c=desktop`, screenId: scrn, expiresAt: 1, mode: 'viewer' },
+    ]) {
+      const result = await requestCloudScreenDelegate({
+        screenId: scrn, credential: 'sdzs_x',
+        fetchImpl: (async () => jsonResponse(200, body)) as unknown as typeof fetch,
+      })
+      expect(result).toEqual({ kind: 'unavailable', reason: 'bad_payload' })
+    }
+  })
+
+  it('reports network failure and timeout without inventing a URL', async () => {
+    const offline = await requestCloudScreenDelegate({
+      screenId: scrn, credential: 'sdzs_x',
+      fetchImpl: (async () => { throw new Error('offline') }) as unknown as typeof fetch,
+    })
+    expect(offline).toEqual({ kind: 'unavailable', reason: 'network' })
+    // A fetch that only settles when its signal aborts: the deadline is the
+    // reason, not an unrelated transport failure.
+    const timeout = await requestCloudScreenDelegate({
+      screenId: scrn, credential: 'sdzs_x', timeoutMs: 5,
+      fetchImpl: ((_url: string, init?: RequestInit) => new Promise<Response>((_resolve, reject) => {
+        init?.signal?.addEventListener('abort', () => { reject(new Error('aborted')) })
+      })) as unknown as typeof fetch,
+    })
+    expect(timeout).toEqual({ kind: 'unavailable', reason: 'timeout' })
+  })
+})
+
+describe('open plan', () => {
+  it('grants the Sidebar guest only when the gateway issued a ticket', () => {
+    expect(planCloudScreen({ kind: 'granted', url: grantedUrl, expiresAt: 1, mode: 'viewer' })).toEqual({
+      kind: 'sidebar-guest', url: grantedUrl,
+    })
+  })
+
+  it('falls back to the system browser with the reason, and refuses without a screen', () => {
+    expect(planCloudScreen({ kind: 'unavailable', reason: 'credential_unsupported_for_gateway' })).toEqual({
+      kind: 'system-browser', url: cloudScreenConsoleUrl(), reason: 'credential_unsupported_for_gateway',
+    })
+    expect(planCloudScreen({ kind: 'refused', status: 410, code: 'lease_expired' })).toEqual({
+      kind: 'system-browser', url: cloudScreenConsoleUrl(), reason: 'refused',
+    })
+    expect(planCloudScreen({ kind: 'unavailable', reason: 'screen_id_required' })).toEqual({
+      kind: 'unavailable', reason: 'screen_id_required',
+    })
+  })
+
+  it('points the fallback at the branded gateway console, never an upstream host', () => {
+    expect(cloudScreenConsoleUrl()).toBe(`${BRAND_CLOUD_DESKTOP_API_ORIGIN}/console.html`)
+  })
+
+  it('lets the shell open only gateway-origin URLs', () => {
+    expect(cloudScreenExternalUrlAllowed(cloudScreenConsoleUrl())).toBe(true)
+    expect(cloudScreenExternalUrlAllowed(grantedUrl)).toBe(true)
+    expect(cloudScreenExternalUrlAllowed('https://evil.example.com/console.html')).toBe(false)
+    expect(cloudScreenExternalUrlAllowed('file:///etc/passwd')).toBe(false)
+    expect(cloudScreenExternalUrlAllowed('dsh-app://app/')).toBe(false)
+    expect(cloudScreenExternalUrlAllowed('https://u:p@agentbuddy.modelxing.com/console.html')).toBe(false)
+    expect(cloudScreenExternalUrlAllowed('not a url')).toBe(false)
+  })
+})
diff --git a/apps/desktop/tests/deep-link.spec.ts b/apps/desktop/tests/deep-link.spec.ts
new file mode 100644
index 0000000000..472612ee4b
--- /dev/null
+++ b/apps/desktop/tests/deep-link.spec.ts
@@ -0,0 +1,42 @@
+import { describe, expect, it } from 'vitest'
+import { LEGACY_DEEP_LINK_SCHEME, parseDeepLink, resolveDeepLinkScheme } from '../src/deep-link.ts'
+
+describe('deep-link schemes', () => {
+  it('normalizes a declared scheme and falls back for absent or malformed values', () => {
+    expect(resolveDeepLinkScheme(' SUISHENDAZI ')).toBe('suishendazi')
+    expect(resolveDeepLinkScheme('dsh')).toBe(LEGACY_DEEP_LINK_SCHEME)
+    expect(resolveDeepLinkScheme(undefined)).toBe(LEGACY_DEEP_LINK_SCHEME)
+    expect(resolveDeepLinkScheme('')).toBe(LEGACY_DEEP_LINK_SCHEME)
+    expect(resolveDeepLinkScheme('not a scheme')).toBe(LEGACY_DEEP_LINK_SCHEME)
+    expect(resolveDeepLinkScheme('1dsh')).toBe(LEGACY_DEEP_LINK_SCHEME)
+    expect(resolveDeepLinkScheme(undefined, 'suishendazi')).toBe('suishendazi')
+  })
+})
+
+describe('open-url classification', () => {
+  it('focuses the app for the bundle scheme, including a future callback path', () => {
+    expect(parseDeepLink('suishendazi://open', 'suishendazi')).toBe('focus-primary-window')
+    expect(parseDeepLink('suishendazi://open/', 'suishendazi')).toBe('focus-primary-window')
+    expect(parseDeepLink('suishendazi://auth/callback?code=redacted', 'suishendazi')).toBe('focus-primary-window')
+  })
+
+  it('keeps reading legacy dsh://open without claiming unrelated dsh paths', () => {
+    expect(parseDeepLink('dsh://open', 'suishendazi')).toBe('focus-primary-window')
+    expect(parseDeepLink('dsh://open/', 'suishendazi')).toBe('focus-primary-window')
+    expect(parseDeepLink('dsh://', 'suishendazi')).toBe('focus-primary-window')
+    expect(parseDeepLink('dsh://auth/callback?code=redacted', 'suishendazi')).toBeUndefined()
+    expect(parseDeepLink('dsh://evil', 'suishendazi')).toBeUndefined()
+  })
+
+  it('keeps upstream behavior when the bundle itself declares dsh', () => {
+    expect(parseDeepLink('dsh://open', 'dsh')).toBe('focus-primary-window')
+    expect(parseDeepLink('dsh://evil', 'dsh')).toBeUndefined()
+  })
