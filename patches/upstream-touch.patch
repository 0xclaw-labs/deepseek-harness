+  it('keeps reading legacy dsh://open without claiming unrelated dsh paths', () => {
+    expect(parseDeepLink('dsh://open', 'suishendazi')).toBe('focus-primary-window')
+    expect(parseDeepLink('dsh://open/', 'suishendazi')).toBe('focus-primary-window')
