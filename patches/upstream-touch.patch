new file mode 100644
index 0000000000..b34572134e
--- /dev/null
+++ b/apps/desktop/src/brand-defaults.ts
@@ -0,0 +1,115 @@
+/**
+ * Brand-owned defaults for a freshly initialized Desktop profile.
+ *
+ * The bundled bundles still describe the upstream deployment: their model
+ * route is the public DeepSeek API, their web search route is DeepSeek's
+ * search API, and their desktop telemetry exporter targets the upstream
+ * collector. A rebranded package must not inherit those deployment choices on
+ * first use. This module writes one reviewed block into the user's profile
+ * patch, which the Host applies after every bundle layer. Later user rows keep
+ * winning, so a saved model or search selection is never overwritten.
+ *
+ * The block is delimited by its own comments because it contains several
+ * rows; the previous generated blocks targeted one row and could be removed by
+ * counting `- id:` lines. `brand-defaults` is a generated marker, not user
+ * content.
+ *
+ * @module @deepseek-ai/dsh-desktop/brand-defaults
+ */
+
+import { existsSync, readFileSync, writeFileSync } from 'node:fs'
+
+/** The branded first-use Workspace row, kept separate because it is regenerated on every move. */
+export function brandWorkspaceBlock(workspacePath: string): string {
+  return '# brand-default-workspace: the branded first-use Workspace, never upstream\'s Documents/deepseek-harness.\n'
+    + '- id: workspace-controller\n'
+    + '  config:\n'
+    + `    defaultWorkspacePath: ${JSON.stringify(workspacePath)}\n`
+}
+
+/** First line of the generated block; also the removal anchor. */
+export const BRAND_DEFAULTS_BEGIN = '# brand-defaults: begin'
+
+/** Last line of the generated block. */
+export const BRAND_DEFAULTS_END = '# brand-defaults: end'
+
+/**
+ * The complete generated block. The provider id is the branded `painuo` route registered by the desktop
+ * catalog bootstrap; model ids stay the upstream-visible namespace. Web search is left unselected so a fresh install never
+ * calls the upstream search endpoint before the user configures a provider.
+ * Telemetry and product analytics are off because this deployment has no
+ * branded collector; enabling them would send events to the upstream
+ * collector named by the bundle's default endpoint.
+ * @returns the block, newline-terminated.
+ */
+export function brandDefaultsBlock(): string {
+  return [
+    `${BRAND_DEFAULTS_BEGIN} - PaiNuo deployment defaults; later user rows win.`,
+    '# Route sessions through the branded account (auth.modelxing.com), not the public DeepSeek API.',
+    '- id: agent-default-model',
+    '  config:',
+    '    provider: painuo',
+    '    model: deepseek-v4.1-flash-1017-local',
+    '# Leave search unselected; a fresh install must not call an upstream search endpoint.',
+    '- id: web',
+    '  config:',
+    '    fetchProvider: http',
+    '# This deployment has no branded collector; never send events to the upstream one.',
+    '- id: desktop-product-telemetry',
+    '  disabled: true',
+    '- id: product-analytics',
+    '  disabled: true',
+    `${BRAND_DEFAULTS_END}`,
+    '',
+  ].join('\n')
+}
+
+/**
+ * Remove one previously generated block without touching user rows.
+ * @param existing - Current profile patch text.
+ * @returns Text with the generated block removed, or the input when a begin
+ *   marker has no end marker (a hand-edited/corrupt block is left alone so a
+ *   rewrite cannot swallow the rows after it).
+ */
+export function stripBrandDefaults(existing: string): string {
+  const begin = existing.indexOf(BRAND_DEFAULTS_BEGIN)
+  if (begin === -1) return existing
+  const end = existing.indexOf(BRAND_DEFAULTS_END, begin)
+  if (end === -1) return existing
+  const afterEnd = existing.slice(end + BRAND_DEFAULTS_END.length)
+  return existing.slice(0, begin) + afterEnd.replace(/^\r?\n/u, '')
+}
+
+/**
+ * Compose the profile patch with exactly one generated defaults block at the
+ * front, preserving user rows and removing the `[]` placeholder an empty
+ * upstream profile ships with. The block is prepended so every later row,
+ * including a user-edited model or search choice, overrides it.
+ * @param existing - Current profile patch text (empty when the file is absent).
+ * @returns The next patch text; identical to `existing` when an unterminated
+ *   generated block is present.
+ */
+export function composeBrandDefaults(existing: string): string {
+  const begin = existing.indexOf(BRAND_DEFAULTS_BEGIN)
+  if (begin !== -1 && existing.indexOf(BRAND_DEFAULTS_END, begin) === -1) return existing
+  const rest = stripBrandDefaults(existing)
+    .split('\n')
+    .filter(line => line.trim() !== '[]')
+    .join('\n')
+    .trim()
+  const block = brandDefaultsBlock()
+  return rest === '' ? block : `${block}${rest}\n`
+}
+
+/**
+ * Create or update the generated defaults block in a profile patch.
+ * @param patchPath - Absolute profile `cordis.patch.yml` path.
+ * @returns Whether the file changed.
+ */
+export function applyBrandDefaults(patchPath: string): boolean {
+  const existing = existsSync(patchPath) ? readFileSync(patchPath, 'utf8') : ''
+  const next = composeBrandDefaults(existing)
+  if (next === existing) return false
+  writeFileSync(patchPath, next, { mode: 0o600 })
+  return true
+}
diff --git a/apps/desktop/src/brand-endpoints.ts b/apps/desktop/src/brand-endpoints.ts
new file mode 100644
index 0000000000..b137534768
--- /dev/null
+++ b/apps/desktop/src/brand-endpoints.ts
@@ -0,0 +1,224 @@
+/**
+ * Brand deployment endpoints for the 随身搭子 desktop.
+ *
+ * The branded app talks to the PaiNuo ecosystem account shim and model proxy,
+ * never to a DeepSeek-operated service. This module is the single runtime copy
+ * of those defaults; `custom/branding/brand.json` records the same values for
+ * packaging and review, and `apps/desktop/tests/brand-endpoints.spec.ts` pins
+ * the two together. Upstream adapters may still describe their own public
+ * endpoints in source, but the branded composition disables those rows. Catalog
+ * display names come from `./model-display.ts`, so the patch this module
+ * generates shows the brand while every wire id stays the provider's own.
+ *
+ * @module
+ */
+
+import { displayModelName, displayProviderName } from './model-display.ts'
+
+/** PaiNuo ecosystem account shim origin (login redirect, grant exchange, account). */
+export const BRAND_AUTH_ORIGIN = 'https://auth.modelxing.com'
+
+/** OpenAI-compatible PaiNuo model proxy base URL. */
+export const BRAND_INFERENCE_BASE_URL = `${BRAND_AUTH_ORIGIN}/pi/v1`
+
+/** Live PaiNuo model catalog used to generate the desktop provider patch. */
+export const BRAND_MODEL_CATALOG_URL = `${BRAND_INFERENCE_BASE_URL}/models`
+
+/**
+ * PaiNuo billing/recharge page served by the gateway under a platform session.
+ * The account surface routes Top up and ledger here; `embedded` stays false, so
+ * the page opens in the browser instead of a viewer that cannot hold the grant.
+ */
+export const BRAND_BILLING_CENTER_URL = 'https://agentbuddy.modelxing.com/billing.html'
+
+/**
+ * Gateway origin for the cloud-desktop (noVNC) surface. The desktop never dials
+ * the box: delegate tickets and the noVNC proxy are gateway paths on this origin.
+ */
+export const BRAND_CLOUD_DESKTOP_API_ORIGIN = 'https://agentbuddy.modelxing.com'
+
+/** Provider id written into the generated profile patch. */
+export const BRAND_PROVIDER_ID = 'painuo'
+
+/** Preferred default model id; the live catalog may expose a different first entry. */
+export const BRAND_DEFAULT_MODEL_ID = 'deepseek-v4.1-flash-1017-local'
+
+/** Hosts owned by DeepSeek that a branded build must never contact by default. */
+const UPSTREAM_DEEPSEEK_DOMAINS = ['deepseek.com', 'deepseeksvc.com'] as const
+
+/** Environment variables that can silently redirect the branded app upstream. */
+const ENDPOINT_OVERRIDE_ENV = [
+  'DSH_PLATFORM_ORIGIN',
+  'DSH_INFERENCE_ORIGIN',
+  'DEEPSEEK_BASE_URL',
+  'DSH_BILLING_CENTER_URL',
+  // Cross-client live cloud desktop: the credential seam. A deployment that can
+  // issue an agentbuddy-audience platform token wires it here; an upstream value
+  // would send the branded app's desktop credential to a DeepSeek service.
+  'DSH_CLOUD_SCREEN_TOKEN',
+  'DSH_TELEMETRY_OTLP_URL',
+  'DSH_PRODUCT_ANALYTICS_OTLP_URL',
+  'DSH_DESKTOP_UPDATE_ORIGIN',
+  'DOWNLOAD_TEST_ORIGIN',
+] as const
+
+/** Return whether a hostname belongs to a DeepSeek-operated service. */
+export function isUpstreamDeepSeekHost(hostname: string): boolean {
+  const normalized = hostname.trim().toLowerCase().replace(/\.$/u, '')
+  return UPSTREAM_DEEPSEEK_DOMAINS.some(domain => normalized === domain || normalized.endsWith(`.${domain}`))
+}
+
+/** Return whether a URL points at a DeepSeek-operated service. */
+export function isUpstreamDeepSeekUrl(value: string): boolean {
+  try {
+    return isUpstreamDeepSeekHost(new URL(value).hostname)
+  } catch {
+    return false
+  }
+}
+
+/**
+ * Reject a deployment endpoint that belongs to DeepSeek.
+ * @param value - endpoint or origin to validate.
+ * @param label - configuration field named in the failure.
+ * @returns the parsed URL when it is not an upstream service.
+ * @throws when the endpoint is malformed or upstream-owned.
+ */
+export function assertBrandEndpoint(value: string, label: string): URL {
+  let url: URL
+  try {
+    url = new URL(value)
+  } catch {
+    throw new Error(`${label} must be an absolute URL`)
+  }
+  if (isUpstreamDeepSeekHost(url.hostname)) {
+    throw new Error(`${label} must not point at an upstream DeepSeek service (${url.hostname})`)
+  }
+  return url
+}
+
+/**
+ * Fail closed when the launching environment overrides a brand endpoint with an
+ * upstream DeepSeek service. Host profiles and user shells may carry stale
+ * DSH_* variables from the upstream app; starting with them would silently
+ * reintroduce the endpoint this fork exists to replace.
+ * @param env - process environment to inspect.
+ * @throws when any endpoint override names an upstream DeepSeek host.
+ */
+export function assertNoUpstreamEndpointOverrides(env: NodeJS.ProcessEnv): void {
+  for (const name of ENDPOINT_OVERRIDE_ENV) {
+    const value = env[name]?.trim()
+    if (value !== undefined && value !== '' && isUpstreamDeepSeekUrl(value)) {
+      throw new Error(`${name} must not point at an upstream DeepSeek service; unset it or use the PaiNuo branded endpoint`)
+    }
+  }
+}
+
+/** One chat model returned by the PaiNuo catalog. */
+export interface BrandCatalogModel {
+  readonly id: string
+  readonly name: string
+}
+
+/**
+ * Pick the default model for the generated provider patch.
+ * @param models - live catalog entries in server order.
+ * @param preferred - model id to use when present.
+ * @returns the preferred id, else the first catalog id, else undefined.
+ */
+export function chooseDefaultModel(
+  models: readonly BrandCatalogModel[],
+  preferred: string = BRAND_DEFAULT_MODEL_ID,
+): string | undefined {
+  if (models.some(model => model.id === preferred)) return preferred
+  return models[0]?.id
+}
+
+/**
+ * Read a grant written by the PaiNuo account shim out of the credential document.
+ * Only a brand-issued opaque grant may become the model proxy bearer; an
+ * upstream DeepSeek account token in the same document is never forwarded.
+ * @param text - complete `$DSH_HOME/.credentials.yaml` contents.
+ * @returns the grant token, or undefined when no valid brand record exists.
+ */
+export function readPaiNuoGrant(text: string): string | undefined {
+  const start = text.indexOf('deepseek-account-platform/default:')
+  if (start === -1) return undefined
+  const block = text.slice(start, start + 512)
+  const token = /token:\s*(\S+)/u.exec(block)?.[1]
+  const issuer = /issuer:\s*(\S+)/u.exec(block)?.[1]
+  if (token === undefined || issuer !== BRAND_AUTH_ORIGIN || !token.startsWith('sdzdsh_')) return undefined
+  return token
+}
+
+/**
+ * Generate the profile patch that mounts the PaiNuo provider and selects its
+ * default model. An empty catalog produces no patch, so a signed-out app keeps
+ * the brand provider disabled rather than falling back to an upstream route.
+ *
+ * Each entry keeps the catalog's wire id and gains a branded display name
+ * (`displayModelName`); the adapter resolves requests, the session log, and the
+ * agent default by id, so a rename here never reaches the wire.
+ * @param models - live PaiNuo catalog entries.
+ * @returns YAML patch block, or an empty string without a catalog.
+ */
+export function paiNuoProviderPatch(models: readonly BrandCatalogModel[]): string {
+  const defaultModel = chooseDefaultModel(models)
+  if (defaultModel === undefined) return ''
+  const list = models
+    .map(model => JSON.stringify({ id: model.id, name: displayModelName(model.id, model.name) }))
+    .join(',')
+  return '# paiNuo-model-provider: PaiNuo ecosystem model catalog (auth.modelxing.com proxy).\n'
+    + '- id: llm-pi-ai\n'
+    + '  config:\n'
+    + '    providers:\n'
+    + `      ${BRAND_PROVIDER_ID}:\n`
+    + `        displayName: ${displayProviderName(BRAND_PROVIDER_ID)}\n`
+    + '        apiKeyEnv: DSH_PAINUO_TOKEN\n'
+    + '        api: openai-completions\n'
+    + `        baseURL: ${BRAND_INFERENCE_BASE_URL}\n`
+    + '        defaultContextWindow: 131072\n'
+    + '        defaultMaxTokens: 8192\n'
+    + `        models: [${list}]\n`
+    + '- id: agent-default-model\n'
+    + '  config:\n'
+    + `    provider: ${BRAND_PROVIDER_ID}\n`
+    + `    model: ${JSON.stringify(defaultModel)}\n`
+}
+
+/**
+ * Fetch the PaiNuo model catalog with the account grant.
+ * @param grant - brand-issued opaque grant.
+ * @param fetchImpl - fetch implementation (injected in tests).
+ * @param timeoutMs - request deadline.
+ * @returns validated chat models, or an empty list on any failure.
+ */
+export async function fetchPaiNuoModels(
+  grant: string,
+  fetchImpl: typeof fetch = fetch,
+  timeoutMs = 5_000,
+): Promise<BrandCatalogModel[]> {
+  const controller = new AbortController()
+  const timer = setTimeout(() => { controller.abort() }, timeoutMs)
+  try {
+    const response = await fetchImpl(BRAND_MODEL_CATALOG_URL, {
+      headers: { authorization: `Bearer ${grant}` }, signal: controller.signal,
+    })
+    if (!response.ok) return []
+    const payload = await response.json() as { data?: Array<{ id?: unknown; endpoint?: unknown; object?: unknown }> }
+    const seen = new Set<string>()
+    const models: BrandCatalogModel[] = []
+    for (const item of payload.data ?? []) {
+      if (typeof item?.id !== 'string' || item.id.length === 0 || seen.has(item.id)) continue
+      if (item.endpoint !== undefined && item.endpoint !== '/v1/chat/completions') continue
+      if (item.endpoint === undefined && item.object !== 'model') continue
+      seen.add(item.id)
+      models.push({ id: item.id, name: item.id })
+    }
+    return models
+  } catch (_error) {
+    return []
+  } finally {
+    clearTimeout(timer)
+  }
+}
diff --git a/apps/desktop/src/cloud-screen.ts b/apps/desktop/src/cloud-screen.ts
new file mode 100644
index 0000000000..e14148dffa
--- /dev/null
+++ b/apps/desktop/src/cloud-screen.ts
@@ -0,0 +1,237 @@
+/**
+ * Cross-client live cloud desktop: the desktop half of the delegate-ticket seam.
+ *
+ * The Sidebar Browser guest runs in its own Electron partition
+ * (`browser-guests.ts`), so it carries no platform session and cannot open the
+ * gateway's noVNC surface by itself. The gateway therefore issues a one-time,
+ * short-lived delegate URL to an already-authenticated client; whoever opens it
+ * lands in the same screen lease without a second sign-in.
+ *
+ * This module owns the main-process half: classify the stored credential, ask
+ * the gateway for a delegate URL, and decide between the Sidebar guest and the
+ * system browser. It performs no UI work and never opens anything itself.
+ *
+ * Honest failure: the branded shim grant (`sdzdsh_`, the model-proxy
+ * credential) is *not* accepted by the gateway, which takes a platform JWT or a
+ * `sdzs_` account session. That credential is refused locally with
+ * `credential_unsupported_for_gateway` instead of being sent to a gateway that
+ * would answer 401; the caller then falls back to the system browser, where the
+ * platform SSO session already lives.
+ *
+ * @module
+ */
+
+import { BRAND_CLOUD_DESKTOP_API_ORIGIN } from './brand-endpoints.ts'
+
+/** Credential wire forms the gateway's `RequirePrincipal` accepts. */
+export type GatewayCredentialKind = 'platform_jwt' | 'account_session' | 'unsupported'
+
+/**
+ * Classify a stored credential by its wire form.
+ * @param token - credential text from the environment or credential document.
+ * @returns the form the gateway routes on, or `unsupported` for anything else.
+ */
+export function classifyGatewayCredential(token: string | undefined): GatewayCredentialKind {
+  const value = token?.trim() ?? ''
+  if (value === '') return 'unsupported'
+  if (value.startsWith('sdzs_')) return 'account_session'
+  // A JWS compact serialization: three base64url segments. Only the form is
+  // classified here; the gateway verifies signature, issuer, and audience.
+  if (/^[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+$/u.test(value)) return 'platform_jwt'
+  return 'unsupported'
+}
+
+/** Why a delegate URL could not be produced. */
+export type CloudScreenUnavailableReason =
+  | 'credential_unsupported_for_gateway'
+  | 'credential_missing'
+  | 'screen_id_required'
+  | 'origin_refused'
+  | 'capability_absent'
+  | 'bad_payload'
+  | 'network'
+  | 'timeout'
+
+/** Outcome of one delegate request. */
+export type CloudScreenDelegateResult =
+  | { readonly kind: 'granted'; readonly url: string; readonly expiresAt: number; readonly mode: string }
+  | { readonly kind: 'refused'; readonly status: number; readonly code: string }
+  | { readonly kind: 'unavailable'; readonly reason: CloudScreenUnavailableReason }
+
+/**
+ * Restrict an opened URL to the gateway's own delegate-redeem endpoint for the
+ * requested screen. The gateway's answer is a credential: a compromised or
+ * proxied gateway must not be able to turn it into an arbitrary navigation.
+ * @param raw - URL from the gateway response.
+ * @param origin - configured gateway origin.
+ * @param screenId - screen the caller asked for.
+ * @returns whether the URL may be opened (or handed to a guest).
+ */
+export function cloudScreenDelegateUrlAllowed(raw: string, origin: string, screenId: string): boolean {
+  if (raw === '' || origin === '' || screenId === '') return false
+  let url: URL
+  try {
+    url = new URL(raw)
+  } catch (_error) {
+    return false
+  }
+  if (url.protocol !== 'https:' && url.protocol !== 'http:') return false
+  if (url.username !== '' || url.password !== '') return false
+  if (url.origin !== origin) return false
+  if (url.pathname !== `/api/npw/screen/${screenId}/delegate/open`) return false
+  return (url.searchParams.get('d') ?? '') !== ''
+}
+
+const responseCode = (body: unknown, status: number): string => {
+  if (typeof body === 'object' && body !== null) {
+    const record = body as Record<string, unknown>
+    if (typeof record.code === 'string' && record.code !== '') return record.code
+    if (typeof record.error === 'string' && record.error !== '') return record.error
+  }
+  return `http_${status}`
+}
+
+/** One delegate request. */
+export interface CloudScreenDelegateRequest {
+  /** Screen channel id (`scrn_…`) the caller wants to open. */
+  readonly screenId: string
+  /** Gateway credential (platform JWT or `sdzs_` account session). */
+  readonly credential: string
+  /** Gateway origin override; defaults to the branded gateway. */
+  readonly origin?: string
+  /** Injected fetch (tests). */
+  readonly fetchImpl?: typeof fetch
+  /** Request deadline; defaults to 5s. */
+  readonly timeoutMs?: number
+}
+
+/**
+ * Ask the gateway for a one-time delegate URL
+ * (`POST /api/npw/screen/{scrnId}/delegate?channel=desktop`).
+ * @param request - screen id, credential, and injectable transport.
+ * @returns the delegate URL, a gateway refusal with its error code, or an honest
+ *   local unavailability reason (never a fabricated URL).
+ */
+export async function requestCloudScreenDelegate(
+  request: CloudScreenDelegateRequest,
+): Promise<CloudScreenDelegateResult> {
+  const origin = request.origin ?? BRAND_CLOUD_DESKTOP_API_ORIGIN
+  const screenId = request.screenId.trim()
+  if (screenId === '') return { kind: 'unavailable', reason: 'screen_id_required' }
+  const credential = request.credential.trim()
+  if (credential === '') return { kind: 'unavailable', reason: 'credential_missing' }
+  const kind = classifyGatewayCredential(credential)
+  if (kind === 'unsupported') return { kind: 'unavailable', reason: 'credential_unsupported_for_gateway' }
+  if (!URL.canParse(origin)) return { kind: 'unavailable', reason: 'origin_refused' }
+
+  const fetchImpl = request.fetchImpl ?? fetch
+  const controller = new AbortController()
+  const timeout = setTimeout(() => { controller.abort() }, request.timeoutMs ?? 5_000)
+  let response: Response
+  try {
+    response = await fetchImpl(`${origin}/api/npw/screen/${encodeURIComponent(screenId)}/delegate?channel=desktop`, {
+      method: 'POST',
+      headers: { authorization: `Bearer ${credential}` },
+      signal: controller.signal,
+    })
+  } catch (_error) {
+    // The deadline owns the distinction: an abort is our timeout, anything else
+    // is the transport failing before a response arrived.
+    return { kind: 'unavailable', reason: controller.signal.aborted ? 'timeout' : 'network' }
+  } finally {
+    clearTimeout(timeout)
+  }
+
+  let body: unknown = null
+  try {
+    body = await response.json()
+  } catch (_error) {
+    body = null
+  }
+  if (response.status === 503) return { kind: 'unavailable', reason: 'capability_absent' }
+  if (!response.ok) return { kind: 'refused', status: response.status, code: responseCode(body, response.status) }
+  if (typeof body !== 'object' || body === null) return { kind: 'unavailable', reason: 'bad_payload' }
+  const record = body as Record<string, unknown>
+  const url = typeof record.url === 'string' ? record.url : ''
+  const returnedScreen = typeof record.screenId === 'string' ? record.screenId : ''
+  const expiresAt = typeof record.expiresAt === 'number' ? record.expiresAt : 0
+  const mode = typeof record.mode === 'string' ? record.mode : ''
+  if (expiresAt <= 0 || returnedScreen !== screenId) return { kind: 'unavailable', reason: 'bad_payload' }
+  if (!cloudScreenDelegateUrlAllowed(url, origin, screenId)) return { kind: 'unavailable', reason: 'bad_payload' }
+  return { kind: 'granted', url, expiresAt, mode }
+}
+
+/** Where a cloud-desktop request should open. */
+export type CloudScreenPlan =
+  /** Open a Sidebar Browser tab with the one-time gateway URL. */
+  | { readonly kind: 'sidebar-guest'; readonly url: string }
+  /**
+   * Open the gateway console in the system browser. The platform SSO session
+   * lives there (same reasoning as the billing center), so this needs no grant
+   * from the app; it is the honest fallback, not an equivalent of the Sidebar.
+   */
+  | { readonly kind: 'system-browser'; readonly url: string; readonly reason: CloudScreenUnavailableReason | 'refused' }
+  /** Nothing can be opened; report why. */
+  | { readonly kind: 'unavailable'; readonly reason: CloudScreenUnavailableReason }
+
+/**
+ * Turn a delegate result into an open decision.
+ * @param result - delegate request outcome.
+ * @returns the plan the renderer executes.
+ */
+export function planCloudScreen(result: CloudScreenDelegateResult): CloudScreenPlan {
+  if (result.kind === 'granted') return { kind: 'sidebar-guest', url: result.url }
+  if (result.kind === 'refused') return { kind: 'system-browser', url: cloudScreenConsoleUrl(), reason: 'refused' }
+  if (result.reason === 'screen_id_required' || result.reason === 'credential_missing') return { kind: 'unavailable', reason: result.reason }
+  return { kind: 'system-browser', url: cloudScreenConsoleUrl(), reason: result.reason }
+}
+
+/**
+ * Restrict a shell-open to the branded gateway origin.
+ *
+ * The renderer may hand back a console URL or a delegate URL; neither needs an
+ * arbitrary-URL opener, so anything off the gateway origin is refused here
+ * rather than relying on the renderer's own check.
+ * @param raw - URL received over IPC.
+ * @returns whether the shell may open it.
+ */
+export function cloudScreenExternalUrlAllowed(raw: string): boolean {
+  let url: URL
+  try {
+    url = new URL(raw)
+  } catch (_error) {
+    return false
+  }
+  return (url.protocol === 'https:' || url.protocol === 'http:')
+    && url.username === '' && url.password === '' && url.origin === BRAND_CLOUD_DESKTOP_API_ORIGIN
+}
+
+/**
+ * Gateway console URL for the system-browser path.
+ * @returns the branded console entry, which lists the caller's computers.
+ */
+export function cloudScreenConsoleUrl(): string {
+  return `${BRAND_CLOUD_DESKTOP_API_ORIGIN}/console.html`
+}
+
+/**
+ * Resolve the credential used for the delegate request.
+ *
+ * `DSH_CLOUD_SCREEN_TOKEN` is the deployment seam: when the platform issues an
+ * agentbuddy-audience token (platform JWT or `sdzs_` session) the environment
+ * carries it and the Sidebar path works with no code change. The branded shim
+ * grant is deliberately not reused here — it is a model-proxy credential and
+ * the gateway rejects it.
+ * @param env - process environment.
+ * @param readShimGrant - reads the account shim's stored grant, when present.
+ * @returns the credential text (possibly empty) and its classified form.
+ */
+export function resolveCloudScreenCredential(
+  env: NodeJS.ProcessEnv,
+  readShimGrant: () => string | undefined,
+): { credential: string; kind: GatewayCredentialKind } {
+  const explicit = env.DSH_CLOUD_SCREEN_TOKEN?.trim() ?? ''
+  if (explicit !== '') return { credential: explicit, kind: classifyGatewayCredential(explicit) }
+  const shim = readShimGrant()?.trim() ?? ''
+  return { credential: shim, kind: classifyGatewayCredential(shim) }
+}
